PROJECT_NAME="hackmeta-26"
FASTAPI_ENV=development
# Expo web dev server. Native apps are not subject to CORS.
FRONTEND_HOST=http://localhost:8081
# Optional override for a prebuilt desktop web client. The combined Docker image
# sets /web; local development defaults to ../frontend/web/dist.
# WEB_DIST_DIR=/web
# SENTRY_DSN=

# SQLite file (default backend/data/app.db) or ":memory:".
# DB_PATH=data/app.db
# "on" enables a shiftable clock. /demo/* requires Surfaces S10.
# "offline" requests fake Muse when the Muse lane is implemented.
# DEMO_MODE=on

# true: every request must carry a login session token (Authorization: Bearer
# mvsess_...); a bare X-User-Id is ignored. Default false keeps the mock picker.
# AUTH_REQUIRE_SESSION=true

# Muse model API (ARCHITECTURE.md 3.2). Anthropic Messages-compatible:
# POST {MUSE_BASE_URL}/v1/messages with "Authorization: Bearer {MUSE_API_KEY}".
# Leave MUSE_API_KEY unset (or DEMO_MODE=offline) to run on the fake client.
MUSE_BASE_URL=https://api.meta.ai
# MUSE_API_KEY=your-hackathon-model-api-key
# Spark 1.3 is the default for lower inference cost.
MUSE_MODEL=muse-spark-1.3
# Short drafts, place extraction and crew labels; other agents use MUSE_MODEL.
MUSE_FAST_MODEL=muse-ember-1.0
# Set only once image input is confirmed to work; unset = text-only fallbacks.
# MUSE_VISION_MODEL=muse-spark-1.3
# Input + output tokens one backend process may spend; after that every agent
# uses its heuristic fallback. GET /muse/status shows tokens_used and the cap.
# MUSE_TOKEN_BUDGET=400000
# true (default): Muse never calls the model; ranking, recommendations and who to
# nudge come from deterministic scores (ARCHITECTURE.md 10). false: ask the model.
# MUSE_DETERMINISTIC=true
# Smoke test once the key is set (calls every agent once, no database):
#   uv run python -m app.muse.smoke

# Postgres connection string. Keep the real value in backend/.env (gitignored).
# When set it wins over DB_PATH (except DB_PATH=":memory:", which tests force).
# Reset and seed it with: uv run python -m app.seed.seed
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Shared invite links (ARCHITECTURE.md 9.4): public origin for /m/{token},
# e.g. a tunnel or subdomain. Unset: the request's host (LAN only).
# PUBLIC_BASE_URL=https://moves.example.com

# Reverse geocoder for the city name at the map's center (GET /areas/city).
# Any Nominatim-compatible server; empty = only the configured areas answer.
# GEOCODER_URL=https://nominatim.openstreetmap.org

# Apple push (APNs), token-based. All four set: notifications also go to
# phones that registered a token (POST /me/push-tokens). Never commit the .p8.
# APNS_KEY_PATH=/run/secrets/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_TOPIC=com.example.app
# APNS_SANDBOX=true

# Remote MCP server for Muse at POST /mcp needs no env: each user mints their
# own token with POST /api/v1/mcp/tokens (README: "Moves MCP server").
# Mark used as the place in DEMO_MODE when none can be found (default Kumo).
# GLASSES_DEMO_MARK_ID=mk_kumo_matcha
