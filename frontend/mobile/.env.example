# Optional. Without it the app talks to port 8000 on whatever machine is
# serving the Expo bundle (your laptop's LAN IP on a phone, localhost on web
# and the iOS simulator). Set it to point at a deployed backend instead.
# EXPO_PUBLIC_BACKEND_URL=https://api.example.com

# Demo build: shows Demo Control in the Menu and lets screens show bundled
# sample data (with a "Sample data" marker). Remove for a normal build.
EXPO_PUBLIC_DEMO=1

# Proximity: "sim" simulates BLE co-presence through Demo Control (works in
# Expo Go). "ble" needs a dev build with the BLE module. Tonight only "sim".
EXPO_PUBLIC_PROXIMITY=sim
