{
  "expo": {
    "name": "hackmeta-26",
    "slug": "hackmeta-26",
    "scheme": "hackmeta26",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.alanroybal.hackmeta26"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "./plugins/withSceneLifecycle",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#ffffff",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "development"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Moves uses your location to show what friends are doing near you and to suggest places. Your exact location never leaves your phone."
        }
      ],
      [
        "./plugins/withManualSigning",
        {
          "teamId": "DVX8YZ9GG9",
          "profile": "HackMeta26 Development",
          "identity": "Apple Development"
        }
      ]
    ],
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
